# URL base del API Gateway compartido (sin barra final). Se incrusta en el build (`npm run build`) y es pública.
# En AWS la pone el workflow Provision a partir del parámetro SSM /urban-alert/plataforma/api-endpoint.
# Vacía en local: `npm run dev` reenvía /api/v1/* a los servicios locales (next.config.ts).
NEXT_PUBLIC_API_URL=
